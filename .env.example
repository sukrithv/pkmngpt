# Which backend to use for generation: "ollama" or "claude"
LLM_BACKEND=ollama

# --- Ollama settings (used when LLM_BACKEND=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Claude API settings (used when LLM_BACKEND=claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Embeddings (always local, keeps indexing free/offline) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=5

# --- Paths ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=pokemon
